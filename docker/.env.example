# App
APP_ENVIRONMENT=development

# Server Database
DATABASE_NAME=app-name-placeholder
DATABASE_USERNAME=app-name-placeholder
DATABASE_PASSWORD=app-name-placeholder

# Keycloak
KEYCLOAK_REALM=app-name-placeholder
KEYCLOAK_CLIENT_ID=app-name-placeholder-server
KEYCLOAK_CLIENT_SECRET=dev-server-secret
KEYCLOAK_RESEARCHER_ROLE=app-name-placeholder-researcher
KEYCLOAK_PARTICIPANT_ROLE=app-name-placeholder-participant
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_DB_NAME=keycloak

# Object Storage (SeaweedFS S3)
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin
S3_BUCKET=app-name-kebab-placeholder
S3_REGION=us-east-1

# Web
VITE_API_BASE_PATH=http://localhost:8080
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=app-name-placeholder
VITE_KEYCLOAK_CLIENT_ID=app-name-placeholder-web
